# ============================
# Variables de Entorno — COARC RefManager Backend
# Copia este archivo como .env y rellena los valores reales
# ============================

# Puerto del servidor API
PORT=5000

# Clave secreta para firmar los tokens JWT
# IMPORTANTE: Usa una cadena larga y aleatoria en producción
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_en_produccion

# ---- Base de Datos PostgreSQL ----
# Para desarrollo local con Docker:
DB_HOST=db
DB_PORT=5432
DB_NAME=coarc_db
DB_USER=postgres
DB_PASSWORD=postgres

# Para producción con Neon/Supabase, usa la URL de conexión directa:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---- URL del Frontend (para CORS) ----
# En producción, pon el dominio exacto donde está desplegado el frontend
FRONTEND_URL=http://localhost:5173
